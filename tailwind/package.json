{
  "name": "haze-design-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Component explorer for the Haze design system \u2014 Tailwind tokens, light/dark themes, WCAG-verified colour.",
  "scripts": {
    "build": "node tools/build-css.mjs",
    "dev": "tailwindcss -i src/input.css -o dist/haze.css --watch",
    "serve": "python3 tools/serve.py 8788",
    "palette": "python3 tools/build-palette.py",
    "test": "vitest run --pool=forks",
    "test:e2e": "playwright test",
    "verify": "npm run palette && npm run build && npm run check:classes && npm run test",
    "check:classes": "node tools/check-classes.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.3",
    "vitest": "^2.1.9"
  }
}
